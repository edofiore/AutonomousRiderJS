# Copy to .env and adjust. All variables are optional; agents can also be
# configured per-run with CLI args (-name=A1 -team=1 -pddl=0) or env vars,
# which take precedence over this file.

# --- Deliveroo server ---
# DELIVEROO_HOST=http://localhost:8080
# DELIVEROO_TOKEN=<jwt>          # NEW = fresh server identity from -name arg

# --- Team coordination (Part 2) ---
# TEAM=1                         # enable teamwork (default 0)
# TEAM_SECRET=edoleo-team-secret # shared secret, must match on both teammates
# HANDOFF_RANGE=2                # max distance to propose a parcel handoff

# --- PDDL planning (Part 3) ---
# PDDL=1                         # enable PddlPlan (default 0 = disabled)
# PDDL_TIMEOUT_MS=5000           # client-side cap on a solver round trip
# PDDL_MAX_FAILURES=3            # circuit breaker threshold
PAAS_HOST=http://localhost:5001
PAAS_PATH=/package/dual-bfws-ffparser/solve

# --- Debugging ---
# DEBUG=1                        # verbose per-tick reasoning logs
# DEBUG_MOVE=1                   # movement tracing

# --- Benchmark (set automatically by benchmark/run-benchmark.js) ---
# BENCH=1                        # periodic METRIC snapshots
# BENCH_DURATION_MS=180000       # self-exit with a final run_end record
# BENCH_SNAPSHOT_MS=5000
# DELIVEROO_DIR=../../../Deliveroo.js   # Deliveroo.js repo for the runner
