# ==============================================================================
# AutonomousRiderJS - Environment Configuration Template
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
#
# Resolution order: CLI args > Environment variables > .env > Defaults
# ==============================================================================

# --- Deliveroo server ---
# Server endpoint (default: http://localhost:4001 or http://localhost:8080)
DELIVEROO_HOST=http://localhost:4001
# Agent JWT token:
# - Leave empty to let the server mint a fresh identity automatically
# - Use 'NEW' to force a fresh token-less connection
# - Or set your custom JWT string
DELIVEROO_TOKEN=

# --- Team coordination ---
#TEAM=1                           # Enable teamwork (1 = enabled, 0 = single agent)
#TEAM_SECRET=edoleo-team-secret   # Shared secret for discovery and authentication
#HANDOFF_RANGE=2                  # Max distance to propose a parcel handoff

# --- PDDL planning ---
# PDDL=1                           # Enable PddlPlan (1 = enabled, 0 = disabled)
# PDDL_TIMEOUT_MS=5000             # Client-side cap on solver round trip (in ms)
# PDDL_MAX_FAILURES=3              # Circuit breaker consecutive failure threshold
PAAS_HOST=http://localhost:5001  # Planning-as-a-service solver URL
PAAS_PATH=/package/dual-bfws-ffparser/solve

# --- Debugging ---
# DEBUG=1                          # Verbose per-tick reasoning logs (1 = on, 0 = off)
# DEBUG_MOVE=1                     # Movement and pathfinding tracing (1 = on, 0 = off)

# --- Benchmark (configured automatically by benchmark/run-benchmark.js) ---
# BENCH=1
# BENCH_DURATION_MS=180000
# BENCH_SNAPSHOT_MS=5000
# DELIVEROO_DIR=../../../Deliveroo.js
